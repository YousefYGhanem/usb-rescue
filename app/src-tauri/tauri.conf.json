{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "USB Rescue",
  "version": "1.3.0",
  "identifier": "io.github.yousefyghanem.usbrescue",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "USB Rescue",
        "width": 1040,
        "height": 680,
        "minWidth": 760,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
